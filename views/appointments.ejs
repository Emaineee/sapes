<%- include('partials/header', { user, title: 'Appointments', path }) %>

<%
  const fmtDate = (iso) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  const fmtTime = (iso) => new Date(iso).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' });
  const initials = (name) => name ? name.split(' ').map((w) => w[0]).slice(0, 2).join('').toUpperCase() : '?';
  const pending = appointments.filter((a) => a.status === 'PENDING').length;
  const approved = appointments.filter((a) => a.status === 'APPROVED').length;
  const completed = appointments.filter((a) => a.status === 'COMPLETED').length;
%>

<main class="container page-shell">
  <section class="page-hero">
    <p class="kicker">University Guidance Center</p>
    <h1>Appointments</h1>
    <p class="lead"><%= user.role === 'admin' || user.role === 'counselor' ? 'Review, approve, and manage all appointment requests.' : 'Book sessions with a guidance counselor and track their status.' %></p>
    <div class="page-hero-actions">
      <a class="btn gold" href="#book">Book an Appointment</a>
    </div>
  </section>

  <% if (error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <section class="stat-grid">
    <div class="stat-card">
      <div class="stat-num"><%= appointments.length %></div>
      <div class="stat-label">Total</div>
    </div>
    <div class="stat-card">
      <div class="stat-num"><%= pending + approved %></div>
      <div class="stat-label">Active</div>
    </div>
    <div class="stat-card">
      <div class="stat-num"><%= completed %></div>
      <div class="stat-label">Completed</div>
    </div>
    <div class="stat-card">
      <div class="stat-num"><%= appointments.filter(a => a.status === 'CANCELLED').length %></div>
      <div class="stat-label">Cancelled</div>
    </div>
  </section>

  <div class="split">
    <section class="page-main">
      <div class="filter-chips" role="group" aria-label="Filter appointments">
        <button class="chip active" data-filter="all">All</button>
        <button class="chip" data-filter="PENDING">Pending</button>
        <button class="chip" data-filter="APPROVED">Approved</button>
        <button class="chip" data-filter="COMPLETED">Completed</button>
        <button class="chip" data-filter="CANCELLED">Cancelled</button>
      </div>

      <% if (appointments.length === 0) { %>
        <div class="card">
          <p class="muted">No appointments yet. Book one using the form.</p>
        </div>
      <% } else { %>
        <div class="appt-list">
          <% appointments.forEach((a) => { %>
            <div class="appt-row" data-status="<%= a.status %>">
              <div class="appt-when">
                <div class="appt-date"><%= fmtDate(a.scheduledAt) %></div>
                <div class="appt-time"><%= fmtTime(a.scheduledAt) %></div>
              </div>
              <div class="appt-main">
                <div class="appt-purpose"><%= a.purpose %></div>
                <div class="appt-meta">
                  <% if (user.role === 'admin' || user.role === 'counselor') { %>
                    <strong><%= a.student ? a.student.firstName + ' ' + a.student.lastName : 'Unknown' %></strong> &middot;
                  <% } %>
                  <span class="counselor-cell">
                    <span class="avatar"><%= a.counselor ? initials(a.counselor.firstName + ' ' + a.counselor.lastName) : '?' %></span>
                    <%= a.counselor ? a.counselor.firstName + ' ' + a.counselor.lastName : 'Unassigned' %>
                  </span>
                </div>
              </div>
              <div class="appt-status">
                <span class="badge status-<%= a.status.toLowerCase() %>"><%= a.status %></span>
              </div>
              <% if (user.role === 'admin' || user.role === 'counselor') { %>
                <div class="appt-actions">
                  <% if (a.status === 'PENDING') { %>
                    <form method="POST" action="/appointments/<%= a.id %>/approve">
                      <button type="submit" class="btn btn-sm ok">Approve</button>
                    </form>
                    <form method="POST" action="/appointments/<%= a.id %>/reject">
                      <button type="submit" class="btn btn-sm danger">Reject</button>
                    </form>
                  <% } else if (a.status === 'APPROVED') { %>
                    <form method="POST" action="/appointments/<%= a.id %>/complete">
                      <button type="submit" class="btn btn-sm ok">Complete</button>
                    </form>
                  <% } else { %>
                    <span class="muted">&mdash;</span>
                  <% } %>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <aside class="aside">
      <div class="card aside-card" id="book">
        <h2>Book an Appointment</h2>
        <form method="POST" action="/appointments">
          <label for="counselorId">Counselor</label>
          <select id="counselorId" name="counselorId" required>
            <option value="">— Select —</option>
            <% counselors.forEach((c) => { %>
              <option value="<%= c.id %>"><%= c.name %> — <%= c.title %></option>
            <% }) %>
          </select>

          <label for="date">Date</label>
          <input type="date" id="date" name="date" required>

          <label for="time">Time</label>
          <input type="time" id="time" name="time" required>

          <label for="purpose">Purpose</label>
          <input type="text" id="purpose" name="purpose" placeholder="e.g. Academic advising, career assessment...">

          <button type="submit" class="btn primary">Schedule Appointment</button>
        </form>
      </div>
    </aside>
  </div>
</main>
<%- include('partials/footer', { user }) %>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var chips = document.querySelectorAll('.chip');
  var rows = document.querySelectorAll('[data-status]');
  chips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      chips.forEach(function (c) { c.classList.remove('active'); });
      chip.classList.add('active');
      var f = chip.dataset.filter;
      rows.forEach(function (row) {
        row.style.display = (f === 'all' || row.dataset.status === f) ? '' : 'none';
      });
    });
  });

  var toggle = document.querySelector('.nav-toggle');
  var links = document.querySelector('.nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', function () {
      var isOpen = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', isOpen);
    });
  }
});
</script>
</body>
</html>
