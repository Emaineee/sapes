<%- include('partials/header', { user, title: 'Home', path }) %>

<%
  const initials = (name) => name.split(' ').map((w) => w[0]).slice(0, 2).join('').toUpperCase();
%>

<main class="container">
  <section class="dashboard-welcome">
    <span class="avatar avatar-lg"><%= initials(user.name) %></span>
    <div class="dashboard-welcome-text">
      <h2>Welcome back, <%= user.firstName %></h2>
      <p><%= user.role === 'admin' ? 'Administrator' : user.role === 'counselor' ? 'Guidance Counselor' : user.role === 'faculty' ? 'Faculty Member' : 'Student' %> • GuideTrack</p>
    </div>
  </section>

  <section class="hero-card">
    <div class="hero-body">
      <p class="kicker">Guidance Management System • University of Perpetual Help System DALTA – Calamba Campus</p>
      <h1>GuideTrack</h1>
      <p class="lead">A BSCpE research study (CPE Practice and Design) to design and develop a guidance management system that streamlines counseling appointments, records, and communication for the College of Engineering.</p>
      <div class="hero-cta">
        <a class="btn primary" href="/letter">View Permission Letter</a>
        <a class="btn outline" href="/appointments">Book an Appointment</a>
        <a class="btn outline" href="/concerns">Report a Concern</a>
      </div>
    </div>
    <aside class="hero-meta">
      <p><span class="badge badge-ok">Approved</span></p>
      <p><strong>Study:</strong> BSCpE • CPE Practice &amp; Design</p>
      <p><strong>Approval:</strong> June 16, 2025</p>
      <p><strong>Signed in as:</strong> <%= user.name %></p>
      <p><strong>Role:</strong> <span class="badge role-<%= user.role %>"><%= user.role %></span></p>
    </aside>
  </section>

  <section class="cards">
    <div class="card">
      <h2>About the System</h2>
      <p><strong>GuideTrack</strong> provides a centralized platform for guidance services — appointment scheduling, counseling records, announcements, and secure communication between students and the guidance office.</p>
      <p class="muted">All information is treated with strict confidentiality and used solely for academic, guidance, and research purposes.</p>
    </div>

    <div class="card">
      <h2>Your Access</h2>
      <p>This page is visible to any signed-in user. Role-based access controls which pages you can open and what you can manage.</p>
      <p class="muted">Your current role is <span class="badge role-<%= user.role %>"><%= user.role %></span></p>
    </div>

    <% if (user.role === 'admin') { %>
      <div class="card highlight">
        <h2>Admin Panel</h2>
        <p>You can manage users, appointments, and reported concerns because your role is <code>admin</code>.</p>
        <a class="btn primary" href="/admin">Open Admin Panel</a>
      </div>
    <% } else { %>
      <div class="card">
        <h2>Need Help?</h2>
        <p>Book an appointment with a guidance counselor or report a concern through the system.</p>
        <a class="btn outline" href="/guidance">View Counselors</a>
      </div>
    <% } %>
  </section>
</main>
<%- include('partials/footer', { user }) %>
<script>
document.addEventListener('DOMContentLoaded', function () {
  var toggle = document.querySelector('.nav-toggle');
  var links = document.querySelector('.nav-links');
  if (toggle && links) {
    toggle.addEventListener('click', function () {
      var isOpen = links.classList.toggle('open');
      toggle.setAttribute('aria-expanded', isOpen);
    });
  }
});
</script>
</body>
</html>
