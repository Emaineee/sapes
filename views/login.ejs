<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — GuideTrack | UPHS-DALTA Calamba</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <main class="card login-card">
    <div class="login-brand">
      <h1>Guide<em>Track</em></h1>
      <p class="muted">Guidance Management System</p>
      <p class="muted">University of Perpetual Help System DALTA – Calamba Campus</p>
    </div>

    <% if (error) { %>
      <div class="alert error"><%= error %></div>
    <% } %>

    <form method="POST" action="/login">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" autocomplete="email" required autofocus>

      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>

      <button type="submit" class="btn primary">Sign in</button>
    </form>

    <div class="demo-hint">
      <p><strong>admin@uphsd.edu.ph</strong> / admin123 → admin role</p>
      <p><strong>student@uphsd.edu.ph</strong> / student123 → student role</p>
      <p>New here? <a href="/register">Create an account</a></p>
    </div>
  </main>
</body>
</html>
