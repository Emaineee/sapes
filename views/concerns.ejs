<%- include('partials/header', { user, title: '', path }) %>

<main class="container">
  <section class="hero">
    <p class="kicker">Student Feedback</p>
    <h1>Concerns &amp; Problems</h1>
    <p class="muted"><%= user.role === 'admin' ? 'Viewing all reports (admin).' : 'Report a concern or problem you are facing.' %></p>
  </section>

  <% if (error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <div class="card">
    <h2>Report a Concern</h2>
    <form method="POST" action="/concerns" class="form-grid">
      <div>
        <label for="category">Category</label>
        <select id="category" name="category" required>
          <option value="">— Select —</option>
          <option>Academic</option>
          <option>Facilities</option>
          <option>Guidance</option>
          <option>Administrative</option>
          <option>Other</option>
        </select>
      </div>

      <div>
        <label for="title">Title</label>
        <input type="text" id="title" name="title" required placeholder="Short summary">
      </div>

      <div class="full">
        <label for="description">Description</label>
        <textarea id="description" name="description" required placeholder="Describe the concern or problem in detail..."></textarea>
      </div>

      <div class="full">
        <button type="submit" class="btn primary">Submit Concern</button>
      </div>
    </form>
  </div>

  <div class="card">
    <h2>Reported Concerns</h2>
    <% if (concerns.length === 0) { %>
      <p class="muted">No concerns reported yet.</p>
    <% } else { %>
      <% concerns.forEach((c) => { %>
        <div class="concern">
          <div class="concern-head">
            <span class="badge status-<%= c.status %>"><%= c.status %></span>
            <strong><%= c.title %></strong>
            <span class="concern-meta muted"><%= c.category %> • <%= c.date %><% if (user.role === 'admin') { %> • <%= c.student %><% } %></span>
          </div>
          <p class="concern-body"><%= c.description %></p>
          <% if (user.role === 'admin') { %>
            <form method="POST" action="/concerns/<%= c.id %>/resolve">
              <button type="submit" class="btn btn-sm <%= c.status === 'resolved' ? 'danger' : 'ok' %>">
                <%= c.status === 'resolved' ? 'Reopen' : 'Mark Resolved' %>
              </button>
            </form>
          <% } %>
        </div>
      <% }) %>
    <% } %>
  </div>
</main>
<%- include('partials/footer', { user }) %>
</body>
</html>